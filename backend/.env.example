# Vulcra backend environment — TEMPLATE ONLY. Copy to `.env` (gitignored) and fill.
# Never commit real values. Real FCC creds are provisioned out-of-repo (see README).

# --- Flare Coston2 (public) ---
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_CHAIN_ID=114
# FlareContractRegistry — the only hardcoded system address; everything else is resolved at runtime.
FLARE_CONTRACT_REGISTRY=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019

# --- Vulcra contracts: MULTI-COLLATERAL, one VaultManager instance per branch ---
# The VaultManager ABI is identical across branches; multi-collateral = multiple
# instances. Set the address for each branch you deploy. A branch is active iff
# its VAULT_MANAGER_<KEY>_ADDRESS is set.
#   FXRP: 6-dec collateral, XRP/USD feed, XRPL-native (0xFE) mint enabled.
#   WFLR: 18-dec collateral (WNat), FLR/USD feed, EVM-only (no 0xFE mint).
VAULT_MANAGER_FXRP_ADDRESS=
VAULT_MANAGER_WFLR_ADDRESS=
# Legacy single-branch var (still honored as the FXRP branch if the above are unset):
# VAULT_MANAGER_ADDRESS=
# Optional per-branch overrides (defaults are the verified Coston2 values):
#   FEED_ID_FXRP=  FEED_ID_WFLR=  COLLATERAL_DECIMALS_FXRP=  COLLATERAL_DECIMALS_WFLR=
VULCRA_ZAP_ADDRESS=
VUSD_ADDRESS=
PRICE_ORACLE_ADDRESS=

# --- Executor signing key (GATED: live mint requires this; boot validates presence) ---
# Funded Coston2 EOA that pays gas + FDC fees and calls executeDirectMintingWithData.
EXECUTOR_PRIVATE_KEY=

# --- Service XRPL wallet (GATED: needed only for service-initiated 0xE0 recovery) ---
SERVICE_XRPL_SEED=

# --- FDC verifier + DA layer (Coston2 testnet) ---
VERIFIER_URL_TESTNET=
VERIFIER_API_KEY_TESTNET=
COSTON2_DA_LAYER_URL=

# --- Executor / indexer service config ---
EXECUTOR_PORT=8787
INDEXER_PORT=8788
EXECUTOR_DB_PATH=./data/executor.sqlite
INDEXER_DB_PATH=./data/indexer.sqlite
FRONTEND_ORIGIN=http://localhost:3000
FTSO_MAX_STALENESS_SECONDS=120

# --- Direct-minting memo defaults ---
WALLET_ID=0

# --- FCC indexer DB (TEE proxy) — provisioned out-of-repo, injected via env ---
# Real values live in a gitignored file OUTSIDE the repo (see README "FCC credentials").
FCC_INDEXER_DB_HOST=
FCC_INDEXER_DB_PORT=3306
FCC_INDEXER_DB_NAME=indexer
FCC_INDEXER_DB_USER=
FCC_INDEXER_DB_PASSWORD=
FCC_TEE_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

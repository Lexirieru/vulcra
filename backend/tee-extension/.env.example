# Vulcra TEE extension — environment TEMPLATE (names only, NO real values).
#
# Copy to .env (gitignored) and fill in. The REAL FCC indexer DB credentials and
# proxy URL come from the out-of-repo, gitignored vulcra-fcc.env provided by the
# Flare hackathon admins — do NOT paste secrets into any committed file.

# ---- Chain / contracts (resolve addresses after deploy; nothing hardcoded
#      except the Flare Contract Registry) ----
COSTON2_RPC_URL=
CHAIN_ID=114
# Optional override; defaults to the Coston2 registry
# 0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
FLARE_CONTRACT_REGISTRY=
VAULT_MANAGER_ADDRESS=
PRICE_ORACLE_ADDRESS=
XRP_USD_FEED_ID=
# Minimum Collateralization Ratio in basis points (default 13000 = 130%)
MCR_BPS=13000

# ---- TEE / attestation mode ----
# Dev: SIMULATED_TEE=true, LOCAL_MODE=false (real Coston2, simulated attestation).
# Prod: SIMULATED_TEE=false, MODE=0.
SIMULATED_TEE=true
LOCAL_MODE=false
MODE=1

# ---- Keeper wallet (TEE-managed key; used via the sign port, NEVER a plaintext
#      key in env). The public keeper address must hold GUARDIAN_EXECUTOR_ROLE on
#      VaultManager for live liquidation/delegatedRepay. Execution is gated on
#      these being set — decisions run regardless. ----
SIGN_PORT=7701
KEEPER_TEE_ADDRESS=

# ---- FCC indexer DB (consumed by ext-proxy, not by the Go process). Real values
#      come from the out-of-repo vulcra-fcc.env. ----
FCC_INDEXER_DB_HOST=
FCC_INDEXER_DB_PORT=3306
FCC_INDEXER_DB_NAME=indexer
FCC_INDEXER_DB_USER=
FCC_INDEXER_DB_PASSWORD=

# ---- Public proxy URL (HTTPS tunnel to ext-proxy port 6674). Real value in
#      vulcra-fcc.env as FCC_TEE_PROXY_URL. ----
FCC_TEE_PROXY_URL=
EXT_PROXY_URL=

# ---- Deployer key for pre-build.sh (funded Coston2 key; NEVER commit) ----
DEPLOYMENT_PRIVATE_KEY=
INITIAL_OWNER=

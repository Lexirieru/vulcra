# Vulcra TEE extension — environment TEMPLATE (names only, NO real values).
#
# Copy to .env (gitignored) and fill in. The REAL FCC indexer DB credentials and
# proxy URL come from the out-of-repo, gitignored vulcra-fcc.env provided by the
# Flare hackathon admins — do NOT paste secrets into any committed file.
#
# The same .env is sourced by the fce-extension-scaffold deployment scripts
# (pre-build.sh / start-services.sh / post-build.sh), so it carries BOTH the
# Vulcra runtime vars and the scaffold's deployment vars. See
# docs/fcc-production-registration.md for the ordered run book.

# ---- Chain / contracts (resolve addresses after deploy; nothing hardcoded
#      except the Flare Contract Registry) ----
COSTON2_RPC_URL=
CHAIN_ID=114
# Optional override; defaults to the Coston2 registry
# 0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
FLARE_CONTRACT_REGISTRY=
PRICE_ORACLE_ADDRESS=
# Minimum Collateralization Ratio in basis points (default 13000 = 130%)
MCR_BPS=13000

# ---- Multi-collateral branches (one VaultManager per branch; same ABI) ----
# A branch is loaded only when its VAULT_MANAGER_<KEY>_ADDRESS is set. Feed ids
# default to protocol constants (XRP/USD for FXRP, FLR/USD for wFLR) and may be
# overridden via FEED_ID_<KEY>. Per-branch MCR via MCR_BPS_<KEY> (else MCR_BPS).
#
# FXRP branch: collateral 6 decimals, feed XRP/USD (6-dec), has XRPL mint path.
VAULT_MANAGER_FXRP_ADDRESS=
# FEED_ID_FXRP=0x015852502f55534400000000000000000000000000
# MCR_BPS_FXRP=13000
#
# wFLR branch: collateral 18 decimals, feed FLR/USD (8-dec), EVM-only (no XRPL).
VAULT_MANAGER_WFLR_ADDRESS=
# FEED_ID_WFLR=0x01464c522f55534400000000000000000000000000
# MCR_BPS_WFLR=13000

# ---- Legacy single-branch (backward compat). If no VAULT_MANAGER_<KEY>_ADDRESS
#      is set but VAULT_MANAGER_ADDRESS is, a single FXRP branch is synthesized
#      from it (honoring XRP_USD_FEED_ID). Prefer the per-branch vars above. ----
VAULT_MANAGER_ADDRESS=
XRP_USD_FEED_ID=

# ---- TEE / attestation mode ----
# Dev: SIMULATED_TEE=true, LOCAL_MODE=false (real Coston2, simulated attestation).
# Prod: SIMULATED_TEE=false, MODE=0.
# LOCAL_MODE MUST be false on Coston2 — it also selects the coston2 branch of the
# scaffold's ADDRESSES_FILE auto-detection.
SIMULATED_TEE=true
LOCAL_MODE=false
MODE=1

# ---- Keeper wallet (TEE-managed key; used via the sign port, NEVER a plaintext
#      key in env). The public keeper address must hold GUARDIAN_EXECUTOR_ROLE on
#      VaultManager for live liquidation/delegatedRepay. Execution is gated on
#      these being set — decisions run regardless. ----
SIGN_PORT=7701
KEEPER_TEE_ADDRESS=

# ---- FCC indexer DB (consumed by ext-proxy, not by the Go process). Real values
#      come from the out-of-repo vulcra-fcc.env. ----
FCC_INDEXER_DB_HOST=
FCC_INDEXER_DB_PORT=3306
FCC_INDEXER_DB_NAME=indexer
FCC_INDEXER_DB_USER=
FCC_INDEXER_DB_PASSWORD=

# =====================================================================
# fce-extension-scaffold deployment variables (pre-build / post-build)
# =====================================================================

# ---- Chain endpoint + address book used by the scaffold tools -------------
# CHAIN_URL is the scaffold's name for the Coston2 RPC (COSTON2_RPC_URL above is
# the enclave's own handle; keep them the same unless you have a reason not to).
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
# Path (inside the scaffold checkout) to the Coston2 address book. Its
# "FlareTeeManager" entry is THE wiring point for the TEE manager — it must be
# the post-redeploy diamond 0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE.
# The old 0x004224faB7BF19a1a67Ee5AF87Cb2b0F0925d41F has had no bytecode since
# 2026-07-22 and every call against it reverts.
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
# Documentation/verification only — no code reads this; the authoritative value
# is the FlareTeeManager entry of ADDRESSES_FILE. Kept here so the run book's
# `cast call` verification steps have one place to read it from.
FLARE_TEE_MANAGER=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE

# ---- Deployer key for pre-build.sh (funded Coston2 key; NEVER commit) ----
# Fund it at https://faucet.flare.network/coston2
DEPLOYMENT_PRIVATE_KEY=
INITIAL_OWNER=
# Optional: separate key used only for AddTeeVersion (falls back to the deployer).
EXTENSION_OWNER_KEY=
# Signing key used by the ext-proxy container (PROXY_PRIVATE_KEY variable name is
# referenced by the proxy toml's `private_key_variable`).
PROXY_PRIVATE_KEY=

# ---- TEE governance ------------------------------------------------------
# The signer set + threshold that govern this extension's TEE machines. BOTH the
# tee-node (which signs its machine data with a governanceHash derived from these)
# and the on-chain registry (set by post-build's set-governance step) read these
# SAME values — if they disagree, register-tee reverts with InvalidGovernanceHash.
# Unset => defaults to INITIAL_OWNER as sole signer, threshold 1.
GOVERNANCE_SIGNERS=
GOVERNANCE_THRESHOLD=1

# ---- Proxy URLs ----------------------------------------------------------
# EXT_PROXY_URL is BOTH the URL the deployment tools call AND (unless
# EXT_PROXY_HOST_URL overrides it) the URL written ON-CHAIN for this TEE machine.
# It MUST therefore be a STABLE public HTTPS URL — a cloudflared *named* tunnel or
# an ngrok *reserved* domain. An ephemeral trycloudflare/ngrok-free URL rotates,
# and the moment it changes the on-chain URL is dead: data providers can no longer
# reach the enclave and the machine never reaches (or falls out of) PRODUCTION.
# The tunnel targets the ext-proxy's HOST port 6674 (container 6664).
EXT_PROXY_URL=
# Optional: register a different public URL on-chain than the one the tools call.
EXT_PROXY_HOST_URL=
# Flare's Coston2 normal/FTDC proxy — the availability check is cosigned there.
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
# Legacy alias for EXT_PROXY_URL, kept because internal/config reads it.
FCC_TEE_PROXY_URL=

# ---- TEE version string registered by allow-tee-version ------------------
TEE_VERSION=v0.1.0

# ---- Vulcra compose overlay ----------------------------------------------
# Absolute path to backend/tee-extension, consumed by
# config/docker/docker-compose.vulcra.coston2.yaml as the image build context.
VULCRA_EXT_DIR=

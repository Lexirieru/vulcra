# ── Vulcra frontend environment ──────────────────────────────────────────────
# Copy to `.env.local` and fill in real values. The build runs with placeholders
# so CI/first-boot never breaks, but the wallet modal needs a real project id.

# Reown Cloud project id (https://dashboard.reown.com). REQUIRED for production
# wallet connection. A public localhost-only fallback is used when unset, which
# is fine for local dev but MUST be replaced before deploying.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Vulcra backend base URL (memo build / pre-flight / mint status / guardian).
# The frontend never builds the 0xFE memo itself — the backend owns it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# ── Multi-collateral branches ────────────────────────────────────────────────
# Each collateral branch is a separate deployed VaultManager instance (SAME ABI).
# The VaultManager address is NOT in FlareContractRegistry, so it must be set per
# branch. Collateral tokens ARE resolved at runtime via the registry where noted;
# the values below are documented fallbacks only. A blank VaultManager => that
# branch shows a "not deployed yet" state.

# FXRP branch (XRP → FXRP). Deployed + source-verified on Coston2
# (smartcontract/deployments/coston2.json). The code already defaults to this
# address; override here only if you redeploy.
NEXT_PUBLIC_VAULT_MANAGER_FXRP=0xB74e100F2C651822082360777dD825c2b24E08E1
NEXT_PUBLIC_COLLATERAL_TOKEN_FXRP=0x0b6A3645c240605887a5532109323A3E12273dc7
# Legacy single-branch alias (still honored as the FXRP fallback):
NEXT_PUBLIC_VAULT_MANAGER_ADDRESS=

# wFLR branch (wrapped C2FLR, 18-dec, symbol WC2FLR). NOT deployed yet — set the
# VaultManager once the wFLR branch is live. The collateral token (WNat/wFLR) is
# resolved at runtime via FlareContractRegistry("WNat"); the value below is only a
# documented fallback (verified: 0xC67DCE33D7A8efA5FfEB961899C73fe01bCe9273).
NEXT_PUBLIC_VAULT_MANAGER_WFLR=
NEXT_PUBLIC_COLLATERAL_TOKEN_WFLR=

# ── Vulcra frontend environment ──────────────────────────────────────────────
# Copy to `.env.local` and fill in real values. The build runs with placeholders
# so CI/first-boot never breaks, but the wallet modal needs a real project id.

# Reown Cloud project id (https://dashboard.reown.com). REQUIRED for production
# EVM wallet connection. A public localhost-only fallback is used when unset,
# which is fine for local dev but MUST be replaced before deploying.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Vulcra backend base URL (memo build / pre-flight / mint status).
# The frontend never builds the 0xFE memo itself — the backend owns it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Guardian confidential-keeper API — the Go tee-extension `guardian-service`
# (TEE node + keeper + REST /guardian/rules). It is a SEPARATE service from the
# executor. Leave blank to reuse NEXT_PUBLIC_API_BASE_URL (single-origin dev);
# set it when the guardian service runs on its own host/port.
NEXT_PUBLIC_GUARDIAN_API_URL=http://localhost:8790

# ── Multi-collateral branches (Vulcra V2) ────────────────────────────────────
# Each collateral branch is a separate deployed VaultManager instance (SAME ABI,
# now with V2 user-set interest rates + by-rate redemption). Addresses below are
# the V2 deployment from smartcontract/deployments/coston2.json and are already
# the in-code defaults; override only if you redeploy. The collateral token is
# resolved at runtime via FlareContractRegistry where noted (no hardcode).

# FXRP branch (XRP → FXRP). Supports XRPL-native 0xFE mint (VulcraZap).
NEXT_PUBLIC_VAULT_MANAGER_FXRP=0x93e572cDbfb62557E041B53490e5208C147b5388
NEXT_PUBLIC_ZAP_FXRP=0xCe4f886e67dE51418751314eEb19aC2D75B59dfE
NEXT_PUBLIC_COLLATERAL_TOKEN_FXRP=0x0b6A3645c240605887a5532109323A3E12273dc7
# Legacy single-branch alias (still honored as the FXRP fallback):
NEXT_PUBLIC_VAULT_MANAGER_ADDRESS=

# wFLR branch (wrapped C2FLR, 18-dec, symbol WC2FLR). EVM-only (no XRPL rail).
# The collateral token (WNat/wFLR) is resolved at runtime via
# FlareContractRegistry("WNat"); the fallback below is documented only.
NEXT_PUBLIC_VAULT_MANAGER_WFLR=0x1F079F205ca2857a3A199937Ace956ed51B0b3b8
NEXT_PUBLIC_COLLATERAL_TOKEN_WFLR=

# Shared vUSD (V2): 0x333FDCf66792122e80654E197Eb6Fa3705f1B6D8 (resolved via
# VaultManager.vusd() at runtime; listed here for reference only).

# ── At-risk vault indexing (Liquidations) ────────────────────────────────────
# Optional Goldsky subgraph per branch. When set, the Liquidations page discovers
# at-risk vaults from the subgraph (all vault events folded to current state, CR
# computed with the live FTSO price) instead of the backend indexer. These are
# PUBLIC read endpoints (no key). The FXRP default below is already baked in;
# leave blank to fall back to the backend `/vaults/at-risk` endpoint. wFLR has no
# subgraph yet, so it always uses the backend.
NEXT_PUBLIC_GOLDSKY_SUBGRAPH_FXRP=https://api.goldsky.com/api/public/project_cmf7w213gukw101tb0u5m7760/subgraphs/vulcra-vaults-fxrp/1.0.0/gn
NEXT_PUBLIC_GOLDSKY_SUBGRAPH_WFLR=

# ── XRPL wallets (Part B) ────────────────────────────────────────────────────
# Crossmark and GemWallet are injected browser extensions — connect + sign fully
# in-browser with NO server API key and NO env config. Xaman (mobile QR/deep-link)
# is offered as a fallback at the payment step and would need a backend Xaman API
# key to auto-generate payloads (not required for the Crossmark/GemWallet path).

# XRPL testnet JSON-RPC used by the wallet sidebar to read the connected
# r-address' XRP balance (account_info). MUST send CORS headers — the canonical
# https://s.altnet.rippletest.net:51234 does NOT, so a browser fetch there is
# blocked. The default below is the public XRPL Labs testnet node (same ledger,
# `access-control-allow-origin: *`). Override only with another CORS-enabled node.
NEXT_PUBLIC_XRPL_RPC_URL=https://testnet.xrpl-labs.com/

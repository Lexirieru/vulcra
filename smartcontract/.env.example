# Vulcra smart-contract deploy configuration — copy to .env and fill in.
# NEVER commit .env or any real private key. .env is gitignored.

# Coston2 RPC (chain 114). Required for simulate, broadcast, and the live fork test.
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Funded deployer key — REQUIRED ONLY for real broadcast (forge script --broadcast).
# The deployer becomes the protocol admin. Leave empty for simulation.
# PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Optional: mint/redemption fee recipient (defaults to the deployer).
# FEE_RECEIVER=0x0000000000000000000000000000000000000000

# Optional: TEE keeper address granted GUARDIAN_EXECUTOR_ROLE for delegated repay.
# GUARDIAN_EXECUTOR=0x0000000000000000000000000000000000000000

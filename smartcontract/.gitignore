# Compiler files
cache/
out/

# Node / npm (flare-periphery-contracts is an npm dependency)
node_modules/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs (ignore forge-generated docs output, but keep hand-written plans)
docs/*
!docs/plans/

# Dotenv file
.env
.env.*
!.env.example
